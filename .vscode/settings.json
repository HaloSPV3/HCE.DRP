{
  "conventionalCommits.scopes": [
    "contributing", // contributing.md
    "deps", // Node,  dependencies
    "release", // Release workflow
    "semantic-release",
    "gitversion",
    "codeql",
    "ci", // CI workflow
    "vscode", // VSCode configs
    "editorconfig",
    "readme",
    "renovate",
    "cpr", // Conventional Pull Request
    "commitizen",
    "SPV3"
  ],
  "files.associations": {
    "**/.vscode/*.json": "jsonc",
    ".vcxproj": "msbuild",
    ".nativeproj": "msbuild"
  },
  "xml.codeLens.enabled": true,
  "github-actions.workflows.pinned.workflows": [
    ".github/workflows/release.yml",
    ".github/workflows/ci.yml"
  ],
  "devskim.ignoreRulesList": [
    "DS187371"
  ],
  "cmake.configureOnOpen": true,
  "cmake.sourceDirectory": "${workspaceFolder}/src",
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "autoRestart.fileGlobForESLint": [
    "**/eslint.config.{js,cjs,mjs,ts}",
    "**/.git/HEAD"
  ],
  "eslint.format.enable": true,
  "cSpell.words": [
    "Arecaidian",
    "CHAINLOAD",
    "COMDAT",
    "CROSSCOMPILING",
    "ctest",
    "endfunction",
    "GITVERSION",
    "halocepresence",
    "halospv",
    "msvc",
    "libgcc",
    "libstdc",
    "msvc",
    "RANLIB",
    "STREQUAL"
  ],
  "eslint.nodePath": ".yarn/sdks",
  "js/ts.tsdk.path": ".yarn/sdks/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "search.exclude": {
    "**/.yarn": true,
    "**/.pnp.*": true
  },
  "C_Cpp.intelliSenseCacheSize": 0,
  "vcpkg.general.enable": true,
  "vcpkg.target.installDependencies": true,
  "vcpkg.target.preferSystemLibs": false,
  "vcpkg.target.useManifest": true,
  "vcpkg.target.useStaticLib": false
}
